# Ollama (open-source LLM) settings — used when running at home
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Hosted open-source LLM (OpenAI-compatible API: Groq, Together, OpenRouter).
# If OPENAI_API_KEY is set, it is used instead of Ollama — required on
# serverless hosts like Vercel. Defaults target Groq's free tier.
#OPENAI_API_KEY=gsk_...
#OPENAI_BASE_URL=https://api.groq.com/openai/v1
#OPENAI_MODEL=llama-3.1-8b-instant

# Behind a reverse proxy / serverless platform (Vercel), trust X-Forwarded-For
# for the WiFi gate. Leave off when running directly at home.
#TRUST_PROXY_HEADER=true

# WiFi gate: comma-separated CIDRs allowed to talk to the app.
# Default (unset) = loopback + all RFC1918 private ranges.
# Tighten to your exact home WiFi subnet for stricter control:
#ALLOWED_SUBNETS=192.168.1.0/24

# Access-code mode: set a secret and the app works from ANY network (any
# house's WiFi), asking each device for the code once. The IP gate defaults
# to open in this mode. Recommended for cloud (Vercel) deployments.
#ACCESS_CODE=pick-a-secret

# Optional: require the *server* to be connected to this WiFi SSID
# (checked with `iwgetid`). Leave unset to skip the SSID check.
#REQUIRED_SSID=MyHomeWiFi

# Connect4 hub: "simulated" (built-in virtual home) or "http" (real hub)
CONNECT4_MODE=simulated
#CONNECT4_HUB_URL=http://connect4-hub.local:9000
