# Ollama (open-source LLM) settings
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# WiFi gate: comma-separated CIDRs allowed to talk to the app.
# Default (unset) = loopback + all RFC1918 private ranges.
# Tighten to your exact home WiFi subnet for stricter control:
#ALLOWED_SUBNETS=192.168.1.0/24

# Optional: require the *server* to be connected to this WiFi SSID
# (checked with `iwgetid`). Leave unset to skip the SSID check.
#REQUIRED_SSID=MyHomeWiFi

# Connect4 hub: "simulated" (built-in virtual home) or "http" (real hub)
CONNECT4_MODE=simulated
#CONNECT4_HUB_URL=http://connect4-hub.local:9000
